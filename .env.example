# .env.example — copy to .env and fill in. NEVER commit .env (secrets).
# Default pipeline is `indic_quality` (Sarvam STT+TTS + OpenAI LLM) on LiveKit Cloud.
# Fill in the keys for whichever pipelines you want to COMPARE (see the matrix below).

# --- LiveKit Cloud (transport; Krisp BVC noise cancellation requires Cloud) ---
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- LLM providers ---
OPENAI_API_KEY=                 # GPT-4.1 / 4.1-mini; also OpenAI transcription (whisper_eval)
GOOGLE_API_KEY=                 # Gemini 2.5 Flash / Flash-Lite (low_cost, global_quality)

# --- Speech providers ---
SARVAM_API_KEY=                 # Saaras STT + Bulbul TTS (indic_quality, translate_bridge)
DEEPGRAM_API_KEY=               # Nova-3 STT (global_stack, low_cost, global_quality)
ELEVENLABS_API_KEY=             # Flash v2.5 TTS (global_stack, global_quality)

# Which keys each pipeline needs (set ACTIVE_PIPELINE to one of these):
#   indic_quality    : LIVEKIT, OPENAI, SARVAM
#   global_stack     : LIVEKIT, OPENAI, DEEPGRAM, ELEVENLABS
#   low_cost         : LIVEKIT, GOOGLE, DEEPGRAM, SARVAM
#   translate_bridge : LIVEKIT, OPENAI, SARVAM
#   global_quality   : LIVEKIT, GOOGLE, DEEPGRAM, ELEVENLABS
#   whisper_eval     : LIVEKIT, OPENAI, SARVAM

# --- App ---
DATABASE_URL=sqlite:///./opd.db
ACTIVE_PIPELINE=indic_quality   # switch this + restart the worker to compare pipelines
DATA_RETENTION_DAYS=30
STAFF_AUTH_SECRET=change-me     # POC only: shared secret for the staff report/compare endpoints
LOG_LEVEL=INFO
PERSIST_TRANSCRIPT=true         # store the full conversation transcript (PHI). Set false to disable.
MIN_ASR_CONFIDENCE=0.5          # below this (and >0) the agent asks the patient to repeat
ASR_LOW_CONFIDENCE_LIMIT=3      # consecutive low-confidence turns before handing off to staff
