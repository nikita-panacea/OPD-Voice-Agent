# .env.example — copy to .env and fill in. NEVER commit .env (secrets).
# POC uses the `indic_quality` pipeline: Sarvam STT+TTS + OpenAI LLM, on LiveKit Cloud.

# --- LiveKit Cloud (transport; Krisp BVC noise cancellation requires Cloud) ---
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- LLM (POC default = OpenAI GPT-4.1; Gemini is a config swap) ---
OPENAI_API_KEY=
GOOGLE_API_KEY=                 # optional in POC (Gemini alternative brain)

# --- Speech (POC uses Sarvam for STT + TTS) ---
SARVAM_API_KEY=

# --- Available but only needed when deferred pipelines are wired ---
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=

# --- App ---
DATABASE_URL=sqlite:///./opd.db
ACTIVE_PIPELINE=indic_quality
DATA_RETENTION_DAYS=30
STAFF_AUTH_SECRET=change-me     # POC only: shared secret for the staff report endpoint
LOG_LEVEL=INFO
